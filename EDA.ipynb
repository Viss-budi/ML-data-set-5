        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import r2_score\n",
        "tr_, te_ = train_test_split(d, test_size=0.2, random_state=RANDOM_STATE)\n",
        "print('R² data uji, satu fitur numerik per model (cek pengganti langsung):')\n",
        "for c in num:\n",
        "    m = LinearRegression().fit(tr_[[c]], tr_['price'])\n",
        "    print('  %-32s %.4f' % (c, r2_score(te_['price'], m.predict(te_[[c]]))))"
