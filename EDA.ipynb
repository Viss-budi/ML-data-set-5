        "print('number_of_reviews == 0          :', (df['number_of_reviews'] == 0).sum())\n",
        "print('Kosong <=> nol ulasan (identik) :', bool((kosong == (df['number_of_reviews'] == 0)).all()))\n",
        "print('last_review kosong = rpm kosong :', bool((df['last_review'].isna() == kosong).all()))"
